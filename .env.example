# =============================================================================
# Xanther — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values you need.
# Most settings have sensible defaults — XME works with zero config in fallback mode.
#
# Minimum for XME (memory only, no code indexing):
#   Nothing required — runs SQLite-only out of the box.
#
# Recommended for XME production:
#   NEO4J_PASSWORD + OPENROUTER_API_KEY (better fact extraction)
#
# Full stack (XME + XCE code intelligence):
#   NEO4J_PASSWORD + OPENROUTER_API_KEY + POSTGRES_URI
# =============================================================================


# -----------------------------------------------------------------------------
# LLM API Keys — for fact extraction and doc generation
# -----------------------------------------------------------------------------
# XME uses LLM extraction when a key is provided.
# Without a key: regex-based heuristic extraction (still works, less precise).
#
# Option 1: OpenRouter (recommended — access to GPT-4o, Claude, Gemini, etc.)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# LLM model for fact extraction (default: openai/gpt-4o-mini — fast + cheap)
# Other good options:
#   anthropic/claude-3-haiku   — fast, good quality
#   google/gemini-flash-1.5    — very cheap
#   openai/gpt-4o              — best quality
XME_LLM_MODEL=openai/gpt-4o-mini
XME_LLM_BASE_URL=https://openrouter.ai/api/v1

# Option 2: Direct OpenAI (if you prefer not to use OpenRouter)
# OPENAI_API_KEY=sk-...
# XME_LLM_BASE_URL=https://api.openai.com/v1
# XME_LLM_MODEL=gpt-4o-mini

# Option 3: Direct Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# XME_LLM_BASE_URL=https://api.anthropic.com
# XME_LLM_MODEL=claude-3-haiku-20240307

# Used by XCE doc generation (component descriptions, architecture docs)
# Can be the same as OPENROUTER_API_KEY
# KIMI_API_KEY=      # Alternative: Moonshot/Kimi API for cheaper doc generation


# -----------------------------------------------------------------------------
# Neo4j — Fact graph storage (Layer 2)
# -----------------------------------------------------------------------------
# XME uses Neo4j for the knowledge graph (decisions, attempts, preferences).
# Falls back to SQLite if Neo4j is unavailable.
#
# Local Docker (recommended for development):
#   docker run -d --name neo4j \
#     -p 7474:7474 -p 7687:7687 \
#     -e NEO4J_AUTH=neo4j/your-password \
#     neo4j:5
#
# Or use docker-compose: `docker-compose up -d neo4j`
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Neo4j Aura (managed cloud, free tier available):
# https://console.neo4j.io → Create free instance → copy URI and password
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<from-aura-console>


# -----------------------------------------------------------------------------
# OpenSearch — Episodic memory search (Layer 1)
# -----------------------------------------------------------------------------
# Used for full-text and semantic search over session transcripts.
# Falls back to SQLite FTS5 if unavailable.
#
# Local Docker:
#   docker-compose up -d opensearch
#
# OpenSearch Serverless (AWS): use the endpoint from your collection
XME_OPENSEARCH_URL=http://localhost:9200
XME_OPENSEARCH_ENABLED=true


# -----------------------------------------------------------------------------
# XME Core Settings
# -----------------------------------------------------------------------------
# SQLite database path (relative to project root or absolute)
XME_SQLITE_PATH=.xanther/xme.db

# Fallback mode: SQLite-only, no Neo4j or OpenSearch needed
# Set to true for zero-infrastructure local use
XME_FALLBACK_MODE=false

# Embedding model — local model, no API key needed
# Downloaded once (~80MB) from HuggingFace on first use
XME_EMBEDDING_MODEL=all-MiniLM-L6-v2
XME_EMBEDDING_DIMS=384

# Deduplication threshold — cosine similarity above this = facts are merged
# 0.85 recommended. Lower = more aggressive merging, higher = more duplicates
XME_DEDUP_THRESHOLD=0.85

# Dashboard port
XME_DASHBOARD_PORT=8001

# Compaction settings — how many lines before the daily log is compacted
XME_COMPACTION_THRESHOLD=300
XME_COMPACT_KEEP_LINES=60


# -----------------------------------------------------------------------------
# XCE Core Settings (code intelligence — optional if using XME standalone)
# -----------------------------------------------------------------------------
# Embedding model for code node vectors (XCE uses higher dims than XME)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_BATCH_SIZE=100

# LLM for component/architecture doc generation
SUMMARIZER_MODEL=moonshot/kimi-k2.5
DOC_GEN_BATCH_SIZE=10

# Layer 3+4 doc generation — enabled by default
# Pre-generated docs help smaller models understand code without reading raw source.
# One expensive index run → many cheaper small model queries consuming pre-digested context.
# Disable if you only use frontier models (GPT-4o, Claude 3.5+) and want faster indexing.
XCE_DEEP_DOCS=true
XCE_ARCH_DOCS=true


# -----------------------------------------------------------------------------
# PostgreSQL — Incremental indexing state (XCE only)
# -----------------------------------------------------------------------------
# Used by XCE to track which files have changed since last index.
# Optional — without it, XCE re-indexes everything on each run.
#
# Local Docker:
#   docker-compose up -d postgres
#
# Format: postgresql://user:password@host:port/database
# POSTGRES_URI=postgresql://xce:xce_dev_password@localhost:5432/xce_index


# -----------------------------------------------------------------------------
# XCE → XME Bridge — sync code facts into XME after indexing (optional)
# -----------------------------------------------------------------------------
# When enabled, XCE writes indexed code symbols + file episodes into XME
# memory layers after each index run. This makes code knowledge queryable
# via the XME hybrid search (code facts + session memory).
#
# Enable:
XME_BRIDGE_ENABLED=false

# Path to XME SQLite db for episodic code file storage
XME_BRIDGE_DB_PATH=.xanther/xme.db

# OpenSearch URL for episodic store (leave empty to use SQLite fallback)
XME_BRIDGE_OPENSEARCH_URL=

# User ID for agent-recorded facts (default: xce_agent)
XME_BRIDGE_USER_ID=xce_agent


# -----------------------------------------------------------------------------
# Optional / Advanced
# -----------------------------------------------------------------------------
# RunPod API key (for GPU-accelerated embedding generation)
# RUN_POD_API_KEY=

# Hugging Face token (for higher rate limits on model downloads)
# HF_TOKEN=hf_...
