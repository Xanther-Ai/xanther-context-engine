# Xanther Context Engine - Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# API Keys
# ===========================================

# OpenRouter (for embeddings - supports multiple providers)
OPENROUTER_API_KEY="your-openrouter-key-here"

# Kimi / Moonshot (for LLM documentation generation)
KIMI_API_KEY="your-kimi-key-here"

# OpenAI (alternative for embeddings and LLM)
OPENAI_API_KEY="your-openai-key-here"

# Anthropic (alternative for LLM)
ANTHROPIC_API_KEY="your-anthropic-key-here"

# ===========================================
# Neo4j Graph Database
# ===========================================

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=xce_dev_password

# Alternative: Use Neo4j Aura (cloud)
# NEO4J_URI=bolt+s://your-instance.neo4j.io:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-aura-password

# ===========================================
# Embedding Configuration
# ===========================================

# Embedding model (openai/text-embedding-3-small, openai/text-embedding-3-large, etc.)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Embedding dimensions (must match the model)
EMBEDDING_DIMENSIONS=512

# Batch size for embedding generation
EMBEDDING_BATCH_SIZE=100

# ===========================================
# LLM / Summarizer Configuration
# ===========================================

# Model for documentation generation
SUMMARIZER_MODEL=moonshot/kimi-k2.5

# Alternative summarizer models
# SUMMARIZER_MODEL=openai/gpt-4o-mini
# SUMMARIZER_MODEL=anthropic/claude-3-haiku

# Batch size for doc generation
DOC_GEN_BATCH_SIZE=10

# ===========================================
# AWS Configuration (optional - for deployment)
# ===========================================

AWS_ACCOUNT_ID=your-account-id
AWS_REGION=us-east-1

# S3 bucket for artifacts (if using AWS)
# S3_BUCKET=your-bucket-name

# ===========================================
# Application Settings
# ===========================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Environment (development, production)
ENV=development

# Database (neo4j, memory)
DB_BACKEND=neo4j